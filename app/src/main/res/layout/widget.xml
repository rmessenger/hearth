<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFF3DC" android:textSize="18sp" android:maxLines="2" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/widget_back" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/back_symbol" android:contentDescription="@string/back_ten" />
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/widget_play" android:layout_width="90dp" android:layout_height="48dp" android:text="@string/play_symbol" android:contentDescription="@string/toggle_playback" />
        <Button style="?android:attr/buttonBarButtonStyle" android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:text="@string/forward_symbol" android:contentDescription="@string/forward_thirty" />
    </LinearLayout>
</LinearLayout>
